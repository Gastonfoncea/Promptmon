# Frontend de PromptMon — copiá a .env.local y completá.
# .env.local está gitignoreado: NO se commitea.

# WalletConnect / Reown project ID (https://cloud.reown.com)
# Habilita el QR para conectar wallets móviles. Si lo dejás vacío, la app
# usa solo la extensión inyectada (MetaMask) sin romper.
NEXT_PUBLIC_WC_PROJECT_ID=
