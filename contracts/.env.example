# Monad testnet (chain id 10143)
MONAD_RPC_URL=https://testnet-rpc.monad.xyz

# Deployer private key — NUNCA commitear el .env real. Será el owner del contrato.
PRIVATE_KEY=0xyour_private_key_here

# Wallet que recibe las fees del mint (default: el deployer)
TREASURY=

# Stablecoins aceptados en Monad testnet (dejalos vacíos si aún no los tenés;
# se habilitan después con setPaymentToken)
USDC_ADDRESS=
USDT_ADDRESS=
# Precio del mint en unidades mínimas del token (10 USDC con 6 decimales)
MINT_PRICE_USDC=10000000

# Verificación en el explorer de Monad testnet (opcional para deploy)
MONAD_ETHERSCAN_KEY=
MONAD_VERIFIER_URL=https://testnet.monadexplorer.com/api
