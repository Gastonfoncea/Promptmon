# PromptMon — variables de entorno (plantilla)
# Copiá este archivo a .env.local y completá los valores reales.
# .env.local está gitignoreado — NUNCA commitees keys reales.

# --- Tripo (AI 3D Pipeline / Dev2) ---
# API key de https://tripo3d.ai (formato tsk_...)
TRIPO_API_KEY=tsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Base URL de la API de Tripo (normalmente no hace falta cambiarla)
TRIPO_API_BASE=https://api.tripo3d.ai/v2/openapi
